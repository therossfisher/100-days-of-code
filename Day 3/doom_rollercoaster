while True:
    print("Welcome to the rollercoaster of DOOM!")
    try:
        height_input = input("What is your height in cm? (or type 'quit' to exit)")
        if height_input == "quit":
            print("Thanks for visiting the rollercoaster of DOOM!")
            break
        height = int(height_input)
        age = int(input("What is your age? "))
    except ValueError:
        print("You can only enter numbers!")
        continue

    if height >= 120:
        print("You can ride the rollercoaster of DOOM!")
    else:
        print("Sorry you have to grow taller before you can ride.")
        continue


    if age > 17:
        print("You need an adult ticket, $18")
        bill = 18
    elif 12 <= age <= 17:
        print("You need a teenage ticket, $12")
        bill = 12
    else:
        print("You need a youth ticket, $7")
        bill = 7

    wants_photo = input("Do YOU want to have a photo taken? Type y for Yes and n for No.\n")
                        
    if wants_photo == "y": 
        bill += 5
    print(f"Your final bill is ${bill}") 