from art import logo

print(logo)

alphabet = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z']


def encrypt(original_text, shift_amount, encode_or_decode):
    output_text = ""
    if encode_or_decode == "decode":
        shift_amount *= -1
        
    for letter in original_text:
        if letter not in alphabet:
            output_text += letter
        else:
            shifted_position = alphabet.index(letter) + shift_amount
            shifted_position %= len(alphabet)
            output_text  += alphabet[shifted_position]
    print(f"Here is the {encode_or_decode}d result: {output_text}\n")


while True:
    while True:
            direction = input("Welcome to the caesar cipher\n"
                              "type 'encode' to encrypt\n"
                              "type 'decode' to decrypt \n"
                              "type 'quit' to exit:\n").lower().strip()
            if direction in ["encode", "decode", "quit"]:
                break
            print("Invalid, try again!")
    if direction == "quit":
        print("Thank you, come again!")
        break
    try:
        text = input("Type your message:\n").lower()
        shift = int(input("Type the shift number:\n"))
    except ValueError:
         print("Only numbers are allowed!")
         continue
    encrypt(original_text=text, shift_amount=shift, encode_or_decode=direction)
    while True:
            try_again = input("Would you like to encode or decode another"
                              " message? Type 'yes' to continue or 'no' to quit\n").lower().strip()
            if try_again in ["yes", "no", "quit"]:
                 break
            print("Invalid, try again!")
    if try_again in ["no", "quit"]:
        print("Thanks for using Caesar Cipher!")
